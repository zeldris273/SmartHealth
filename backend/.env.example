# SmartHealth Backend Environment Variables

DATABASE_URL=postgresql://postgres:your-password@localhost:5432/smarthealth_db

SMTP_USER=test@example.com
SMTP_PASSWORD=test_password
ADMIN_EMAIL=admin@example.com

# JWT Secret Key (generate a strong secret key for production!)
# You can generate one using: openssl rand -hex 32
SECRET_KEY=thay-doi-sau

# JWT Algorithm
ALGORITHM=HS256

# JWT Token Expiration (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Chatbot AI provider: openai
AI_PROVIDER=openai

# OpenAI settings
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=your-openai-api-key-here

# Google OAuth (Web application client — cùng một Client ID cho frontend và backend)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
