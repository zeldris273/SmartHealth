# SmartHealth Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Database Connection
# Examples:
# - SQLite: sqlite:///./smarthealth.db
# - PostgreSQL: postgresql://user:password@localhost:5432/smarthealth_db
# - MySQL: mysql+pymysql://user:password@localhost:3306/smarthealth_db
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/smarthealth_db

SMTP_USER=test@example.com
SMTP_PASSWORD=test_password

# JWT Secret Key (generate a strong secret key for production!)
# You can generate one using: openssl rand -hex 32
SECRET_KEY=thay-doi-sau

# JWT Algorithm
ALGORITHM=HS256

# JWT Token Expiration (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Gemini API Key (for chatbot feature, optional)
# Get one from: https://aistudio.google.com/app/apikey

# Chatbot AI provider: gemini | openai
AI_PROVIDER=openai

# Gemini settings
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI settings
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=your-openai-api-key-here
